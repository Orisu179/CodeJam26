#include "resource.h"
#include <winresrc.h>

IDD_OKCONVOLUTION_BIG DIALOGEX 0, 0, 260, 115
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON "Browse IR (.wav)...", IDC_BUTTON_BROWSE_IR, 12, 12, 110, 18

    LTEXT "Active IR Slot", -1, 12, 42, 80, 13
    LTEXT "Class=SuperRange;Prop=ActiveIRIndex", IDC_RANGE_ACTIVE_IR_INDEX, 96, 40, 65, 13, WS_BORDER

    LTEXT "Dry Wet Mix", -1, 12, 62, 80, 13
    LTEXT "Class=SuperRange;Prop=DryWetMix", IDC_RANGE_DRY_WET_MIX, 96, 60, 65, 13, WS_BORDER

    LTEXT "Cross Fade Time", -1, 12, 82, 80, 13
    LTEXT "Class=SuperRange;Prop=CrossFadeTime", IDC_RANGE_CROSS_FADE_TIME, 96, 80, 65, 13, WS_BORDER
END
